// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  USER
  CHECKIN_KIDS
  CHECKIN_KIDS_ADMIN
  MEDICAL_STAFF
  EXECUTIVE_ASSISTANT
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum TwoFactorType {
  NONE
  WHATSAPP
  TOTP
}

// ==========================================
// MULTI-TENANT ARCHITECTURE (SistemasElim.app)
// ==========================================

model Organization {
  id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  slug     String             @unique
  domain   String?            @unique
  logoUrl  String?
  status   OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  passwordVaults   PasswordVault[]
  events           Event[]
  conciliations    Conciliation[]
  kids             Kid[]
  classrooms       Classroom[]
  checkIns         CheckIn[]
  medicalPatients  MedicalPatient[]
  calendarIntegrations CalendarIntegration[]
  tasks            Task[]
  roleTemplates    RoleTemplate[]
  activosFijos     ActivoFijo[]

  @@map("organizations")
}

model User {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String @unique
  
  // Tenancy & RBAC
  organizationId String @db.Uuid
  role           Role   @default(USER)
  customRoleName String? // Mapea al nombre de un RoleTemplate si se usó uno
  accessibleModules String[] @default([])

  // Security & MFA
  phoneNumber       String?
  twoFactorType     TwoFactorType @default(NONE)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean       @default(false)

  // Auth Relation (Supabase Auth ID will map to this ID or we can query by email)
  
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicalRecords MedicalRecord[]
  calendarIntegrations CalendarIntegration[]

  @@map("users")
}

// ==========================================
// ROLE TEMPLATES (Dynamic Roles)
// ==========================================

model RoleTemplate {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @db.Uuid
  name              String
  baseRole          Role         @default(USER)
  accessibleModules String[]     @default([])
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@unique([organizationId, name]) // A organization shouldn't have duplicate role names
  @@map("role_templates")
}

// ==========================================
// BUSINESS MODELS (Isolated by Organization)
// ==========================================

model PasswordVault {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  
  title          String
  username       String
  encryptedPass  String
  url            String?
  notes          String?
  category       String @default("General")
  details        Json?  // Propiedades dinámicas guardadas en JSONB
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("password_vaults")
}

model Event {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

model Conciliation {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid

  banco          String
  tipoCuenta     String
  month          Int
  year           Int
  status         String    @default("PROCESSING") // PROCESSING | COMPLETED | FAILED
  reportContent  Json?     // Full structured report from Claude
  reportSummary  String?   // Short text summary
  filesFound     String[]  // List of Drive filenames used
  isApproved     Boolean   @default(false)
  approvedBy     String?
  approvedAt     DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conciliations")
}

// ==========================================
// CHECKIN KIDS MODULE
// ==========================================

model Classroom {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  ageRange       String?
  teacher        String?
  capacity       Int      @default(20)
  color          String?  @default("bg-brand-100 text-brand-700 border-brand-200")
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kids           Kid[]

  @@map("classrooms")
}

model Kid {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  age            Int
  gender         String   @default("No Especificado")
  classroomId    String?  @db.Uuid
  classroomName  String?  // Removed the requirement to keep historic name just in case, or keep it, keeping it doesn't hurt, but if related, better to use relation
  allergies      String   @default("Ninguna")
  parentName     String
  parentPhone    String
  photoEmoji     String   @default("🧒")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classroom      Classroom?   @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  checkIns       CheckIn[]

  @@map("kids")
}

model CheckIn {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  kidId          String    @db.Uuid
  securityCode   String
  checkInTime    DateTime  @default(now())
  checkOutTime   DateTime?
  checkedOut     Boolean   @default(false)
  parentNotified Boolean   @default(false)
  notifProvider  String?
  notifMessageId String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kid          Kid          @relation(fields: [kidId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}

// ==========================================
// MEDICAL ASSISTANCE
// ==========================================

model MedicalPatient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         String
  phone          String?
  email          String?
  address        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  
  bloodType      String?
  allergies      String?
  chronicConditions String?
  currentMedications String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records        MedicalRecord[]

  // Indexes for quick searching
  @@index([organizationId])
  @@index([firstName, lastName])
  @@index([phone])

  @@map("medical_patients")
}

model MedicalRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId      String   @db.Uuid
  attendedById   String   @db.Uuid // Reference to User ID of Medical Staff

  visitDate      DateTime @default(now())
  reasonForVisit String
  vitals         Json?    // Optional: temperature, bloodPressure, heartRate, etc.
  diagnosis      String?
  treatment      String?
  notes          String?
  
  status         String   @default("COMPLETED") // e.g., PENDING, IN_PROGRESS, COMPLETED
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        MedicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  attendedBy     User           @relation(fields: [attendedById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([visitDate])

  @@map("medical_records")
}

// ==========================================
// CENTRALIZED CALENDAR & TASKS
// ==========================================

model CalendarIntegration {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid // who authorized this
  
  googleAccessToken  String
  googleRefreshToken String
  googleEmail        String
  syncToken          String?  // For delta sync
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, organizationId])
  @@map("calendar_integrations")
}

model Task {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  
  title          String
  description    String?
  status         String @default("TODO") // TODO, IN_PROGRESS, DONE
  priority       String @default("MEDIUM") // LOW, MEDIUM, HIGH
  dueDate        DateTime?
  
  // If dragged to the calendar, we map it to googleEventId so we don't duplicate/we can sync back
  googleEventId  String?
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("tasks")
}

// ==========================================
// INVENTARIO DE ACTIVOS FIJOS
// ==========================================

model ActivoFijo {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @db.Uuid
  idQr                 String    // Auto-generado: "PB-A8-OF.EB-0001"

  // Descripción
  descripcionCorta     String
  descripcionDetallada String?
  serie                String?
  modelo               String?

  // Clasificación
  area             String    // Abreviatura del área (PB-A1-OF.PASTOR, etc.)
  cuentaAct        String    // Cuenta contable (Terrenos, Edificios, etc.)
  estatusContable  String    @default("VIGENTE") // VIGENTE | DEPRECIADO | PROCESO DE BAJA

  // Adquisición
  fechaAdq         DateTime?
  fechaLevantamiento DateTime? // Fecha en la que se levantó físicamente el inventario
  integrado        Boolean   @default(false)
  costoAdq         Decimal?  @db.Decimal(12, 2)
  origenActivo     String?   // "Compra" | "Donación"

  // Imagen
  imagenUrl        String?   // URL pública de Cloudflare R2
  imagenPlacaUrl   String?   // URL pública de la placa de especificaciones

  // Estado físico
  estadoDano        String?   // DAÑADO | FALTANTE | NO REGISTRADO | INSERVIBLE
  tipoIncidencia    String?   // Faltante | Extraviado | No Registrado
  accionRecomendada String?   // Reparar | Dar de baja | Reponer
  responsable       String?
  observaciones     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, idQr])
  @@index([organizationId])
  @@map("activos_fijos")
}
