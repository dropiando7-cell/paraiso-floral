// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  USER
  CHECKIN_KIDS
  MEDICAL_STAFF
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum TwoFactorType {
  NONE
  WHATSAPP
  TOTP
}

// ==========================================
// MULTI-TENANT ARCHITECTURE (SistemasElim.app)
// ==========================================

model Organization {
  id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  slug     String             @unique
  domain   String?            @unique
  logoUrl  String?
  status   OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  passwordVaults   PasswordVault[]
  events           Event[]
  conciliations    Conciliation[]
  kids             Kid[]
  checkIns         CheckIn[]
  medicalPatients  MedicalPatient[]

  @@map("organizations")
}

model User {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String @unique
  
  // Tenancy & RBAC
  organizationId String @db.Uuid
  role           Role   @default(USER)

  // Security & MFA
  phoneNumber       String?
  twoFactorType     TwoFactorType @default(NONE)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean       @default(false)

  // Auth Relation (Supabase Auth ID will map to this ID or we can query by email)
  
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicalRecords MedicalRecord[]

  @@map("users")
}

// ==========================================
// BUSINESS MODELS (Isolated by Organization)
// ==========================================

model PasswordVault {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  
  title          String
  username       String
  encryptedPass  String
  url            String?
  notes          String?
  category       String @default("General")
  details        Json?  // Propiedades dinámicas guardadas en JSONB
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("password_vaults")
}

model Event {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

model Conciliation {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid

  banco          String
  tipoCuenta     String
  month          Int
  year           Int
  status         String    @default("PROCESSING") // PROCESSING | COMPLETED | FAILED
  reportContent  Json?     // Full structured report from Claude
  reportSummary  String?   // Short text summary
  filesFound     String[]  // List of Drive filenames used
  isApproved     Boolean   @default(false)
  approvedBy     String?
  approvedAt     DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conciliations")
}

// ==========================================
// CHECKIN KIDS MODULE
// ==========================================

model Kid {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  age            Int
  classroomId    String
  classroomName  String
  allergies      String   @default("Ninguna")
  parentName     String
  parentPhone    String
  photoEmoji     String   @default("🧒")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkIns     CheckIn[]

  @@map("kids")
}

model CheckIn {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  kidId          String    @db.Uuid
  securityCode   String
  checkInTime    DateTime  @default(now())
  checkOutTime   DateTime?
  checkedOut     Boolean   @default(false)
  parentNotified Boolean   @default(false)
  notifProvider  String?
  notifMessageId String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kid          Kid          @relation(fields: [kidId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}

// ==========================================
// MEDICAL ASSISTANCE
// ==========================================

model MedicalPatient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         String
  phone          String?
  email          String?
  address        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  
  bloodType      String?
  allergies      String?
  chronicConditions String?
  currentMedications String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records        MedicalRecord[]

  // Indexes for quick searching
  @@index([organizationId])
  @@index([firstName, lastName])
  @@index([phone])

  @@map("medical_patients")
}

model MedicalRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId      String   @db.Uuid
  attendedById   String   @db.Uuid // Reference to User ID of Medical Staff

  visitDate      DateTime @default(now())
  reasonForVisit String
  vitals         Json?    // Optional: temperature, bloodPressure, heartRate, etc.
  diagnosis      String?
  treatment      String?
  notes          String?
  
  status         String   @default("COMPLETED") // e.g., PENDING, IN_PROGRESS, COMPLETED
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        MedicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  attendedBy     User           @relation(fields: [attendedById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([visitDate])

  @@map("medical_records")
}
