// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  USER
  CHECKIN_KIDS
  CHECKIN_KIDS_ADMIN
  MEDICAL_STAFF
  EXECUTIVE_ASSISTANT
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum TwoFactorType {
  NONE
  WHATSAPP
  TOTP
}

enum EmailTemplateType {
  CLASSIC_WELCOME
  GOOGLE_WELCOME
}

// ==========================================
// MULTI-TENANT ARCHITECTURE (SistemasElim.app)
// ==========================================

model Organization {
  id       String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String
  slug     String             @unique
  domain   String?            @unique
  logoUrl  String?
  status   OrganizationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  passwordVaults   PasswordVault[]
  events           Event[]
  conciliations    Conciliation[]
  kids             Kid[]
  classrooms       Classroom[]
  checkIns         CheckIn[]
  medicalPatients  MedicalPatient[]
  calendarIntegrations CalendarIntegration[]
  tasks            Task[]
  roleTemplates    RoleTemplate[]
  emailTemplates   EmailTemplate[]
  activosFijos     ActivoFijo[]
  colaImpresion    ColaImpresion[]
  areaInventoryStatuses AreaInventoryStatus[]
  areas                 Area[]

  @@map("organizations")
}

model User {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String @unique
  
  // Tenancy & RBAC
  organizationId String @db.Uuid
  role           Role   @default(USER)
  customRoleName String? // Mapea al nombre de un RoleTemplate si se usó uno
  accessibleModules String[] @default([])

  // Security & MFA
  phoneNumber       String?
  twoFactorType     TwoFactorType @default(NONE)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean       @default(false)

  // User Preferences
  defaultModule     String?
  timezone          String?       @default("America/Tegucigalpa")
  theme             String?       @default("system")

  // Auth Relation (Supabase Auth ID will map to this ID or we can query by email)
  
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicalRecords MedicalRecord[]
  calendarIntegrations CalendarIntegration[]
  
  openedAreas AreaInventoryStatus[] @relation("AreaOpenedBy")
  closedAreas AreaInventoryStatus[] @relation("AreaClosedBy")
  approvedAreas AreaInventoryStatus[] @relation("AreaApprovedBy")

  @@map("users")
}

// ==========================================
// ROLE TEMPLATES (Dynamic Roles)
// ==========================================

model RoleTemplate {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @db.Uuid
  name              String
  baseRole          Role         @default(USER)
  accessibleModules String[]     @default([])
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@unique([organizationId, name]) // A organization shouldn't have duplicate role names
  @@map("role_templates")
}

// ==========================================
// EMAIL TEMPLATES (Customization)
// ==========================================

model EmailTemplate {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  type           EmailTemplateType
  
  subject        String            
  title          String            
  body           String            @db.Text
  buttonText     String            
  
  isActive       Boolean           @default(true) // Si es falso, se usaría un fallback por defecto en el código
  
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@unique([organizationId, type]) // Solo puede haber un template activo por tipo por organización
  @@map("email_templates")
}

// ==========================================
// BUSINESS MODELS (Isolated by Organization)
// ==========================================

model PasswordVault {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  
  title          String
  username       String
  encryptedPass  String
  url            String?
  notes          String?
  category       String @default("General")
  details        Json?  // Propiedades dinámicas guardadas en JSONB
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("password_vaults")
}

model Event {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

model Conciliation {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid

  banco          String
  tipoCuenta     String
  month          Int
  year           Int
  status         String    @default("PROCESSING") // PROCESSING | COMPLETED | FAILED
  reportContent  Json?     // Full structured report from Claude
  reportSummary  String?   // Short text summary
  filesFound     String[]  // List of Drive filenames used
  isApproved     Boolean   @default(false)
  approvedBy     String?
  approvedAt     DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conciliations")
}

// ==========================================
// CHECKIN KIDS MODULE
// ==========================================

model Classroom {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  ageRange       String?
  teacher        String?
  capacity       Int      @default(20)
  color          String?  @default("bg-brand-100 text-brand-700 border-brand-200")
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kids           Kid[]

  @@map("classrooms")
}

model Kid {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  age            Int
  gender         String   @default("No Especificado")
  classroomId    String?  @db.Uuid
  classroomName  String?  // Removed the requirement to keep historic name just in case, or keep it, keeping it doesn't hurt, but if related, better to use relation
  allergies      String   @default("Ninguna")
  parentName     String
  parentPhone    String
  photoEmoji     String   @default("🧒")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classroom      Classroom?   @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  checkIns       CheckIn[]

  @@map("kids")
}

model CheckIn {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  kidId          String    @db.Uuid
  securityCode   String
  checkInTime    DateTime  @default(now())
  checkOutTime   DateTime?
  checkedOut     Boolean   @default(false)
  parentNotified Boolean   @default(false)
  notifProvider  String?
  notifMessageId String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kid          Kid          @relation(fields: [kidId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}

// ==========================================
// MEDICAL ASSISTANCE
// ==========================================

model MedicalPatient {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  firstName      String
  lastName       String
  dateOfBirth    DateTime
  gender         String
  phone          String?
  email          String?
  address        String?
  emergencyContactName  String?
  emergencyContactPhone String?
  
  bloodType      String?
  allergies      String?
  chronicConditions String?
  currentMedications String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records        MedicalRecord[]

  // Indexes for quick searching
  @@index([organizationId])
  @@index([firstName, lastName])
  @@index([phone])

  @@map("medical_patients")
}

model MedicalRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId      String   @db.Uuid
  attendedById   String   @db.Uuid // Reference to User ID of Medical Staff

  visitDate      DateTime @default(now())
  reasonForVisit String
  vitals         Json?    // Optional: temperature, bloodPressure, heartRate, etc.
  diagnosis      String?
  treatment      String?
  notes          String?
  
  status         String   @default("COMPLETED") // e.g., PENDING, IN_PROGRESS, COMPLETED
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient        MedicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  attendedBy     User           @relation(fields: [attendedById], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([visitDate])

  @@map("medical_records")
}

// ==========================================
// CENTRALIZED CALENDAR & TASKS
// ==========================================

model CalendarIntegration {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  userId         String @db.Uuid // who authorized this
  
  googleAccessToken  String
  googleRefreshToken String
  googleEmail        String
  syncToken          String?  // For delta sync
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, organizationId])
  @@map("calendar_integrations")
}

model Task {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  
  title          String
  description    String?
  status         String @default("TODO") // TODO, IN_PROGRESS, DONE
  priority       String @default("MEDIUM") // LOW, MEDIUM, HIGH
  dueDate        DateTime?
  
  // If dragged to the calendar, we map it to googleEventId so we don't duplicate/we can sync back
  googleEventId  String?
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("tasks")
}

// ==========================================
// INVENTARIO DE ACTIVOS FIJOS
// ==========================================

model ActivoFijo {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String    @db.Uuid
  idQr                 String    // Auto-generado: "PB-A8-OF.EB-0001"

  // Descripción
  descripcionCorta     String
  descripcionDetallada String?
  serie                String?
  modelo               String?
  codigoGrupo          String?   // "001" (asignado manualmente para agrupar en ELIM-PB-A01-TMP-001)

  // Clasificación
  area             String    // Abreviatura del área (PB-A1-OF.PASTOR, etc.)
  cuentaAct        String    // Cuenta contable (Terrenos, Edificios, etc.)
  estatusContable  String    @default("VIGENTE") // VIGENTE | DEPRECIADO | PROCESO DE BAJA

  // Adquisición
  fechaAdq         DateTime?
  fechaLevantamiento DateTime? // Fecha en la que se levantó físicamente el inventario
  integrado        Boolean   @default(false)
  costoAdq         Decimal?  @db.Decimal(12, 2)
  origenActivo     String?   // "Compra" | "Donación"

  // Imagen
  imagenUrl        String?   // URL pública de Cloudflare R2
  imagenPlacaUrl   String?   // URL pública de la placa de especificaciones

  // Estado físico
  estadoDano        String?   // DAÑADO | FALTANTE | NO REGISTRADO | INSERVIBLE
  tipoIncidencia    String?   // Faltante | Extraviado | No Registrado
  accionRecomendada String?   // Reparar | Dar de baja | Reponer
  responsable       String?
  observaciones     String?

  // Depreciación & Conciliación Histórica (Reglamento Hondureño)
  historicoId           String?              @db.Uuid
  inventarioHistorico   InventarioHistorico? @relation(fields: [historicoId], references: [id], onDelete: SetNull)
  categoriaDepreciacion String?              // Asignación manual para "Activos Nuevos" (ej. "COMPUTACION_10")
  vidaUtilOverride      Decimal?            @db.Decimal(5, 2) // Sobrescritura opcional por parte del usuario (ej. "Mejoras a Edificios")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  colaImpresion ColaImpresion[]

  @@unique([organizationId, idQr])
  @@index([organizationId])
  @@index([organizationId, estatusContable])
  @@index([organizationId, estadoDano])
  @@index([organizationId, area])
  @@map("activos_fijos")
}

model AreaInventoryStatus {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  
  areaCode       String    // El código interno del área que se guarda en ActivoFijo.area (ej. PB-A1-OF.PASTOR)
  qrCode         String    // El código QR físico de la puerta (ej. ELIM-QR-PB-A01-OFI)
  status         String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED
  
  openedById     String?   @db.Uuid // Usuario que escaneó el QR por primera vez
  closedById     String?   @db.Uuid // Usuario que indicó "Terminé de inventariar"
  approvedById   String?   @db.Uuid // Admin que autorizó la reapertura
  
  openedAt       DateTime?
  closedAt       DateTime?
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openedBy       User?        @relation("AreaOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy       User?        @relation("AreaClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  approvedBy     User?        @relation("AreaApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([organizationId, areaCode])
  @@unique([organizationId, qrCode])
  @@index([organizationId])
  @@map("area_inventory_status")
}

// ==========================================
// SERVIDOR DE IMPRESION LOCAL
// ==========================================

model ColaImpresion {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  activoId       String   @db.Uuid
  urlImagen      String   // URL de la etiqueta en S3/Cloudflare R2
  estado         String   @default("PENDIENTE") // PENDIENTE | COMPLETADO
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activo         ActivoFijo   @relation(fields: [activoId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([estado])
  @@map("cola_impresion")
}

// ==========================================
// MANTENIMIENTO DINAMICO DE AREAS
// ==========================================

model Area {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  
  name           String    // Nombre/Código único corto del área (ej. PB-A1-OF.PASTOR)
  prefix         String    // Prefijo para IDs (ej. ELIM-PB-A01-OF)
  qrCode         String    // Código QR que se imprime y pega en la puerta (ej. ELIM-QR-PB-A01-OFI)
  
  description    String?   // Descripción o ubicación detallada opcional
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@unique([organizationId, qrCode])
  @@index([organizationId])
  @@map("areas")
}

// ==========================================
// INVENTARIO HISTORICO (CONCILIACIÓN)
// ==========================================

model InventarioHistorico {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @db.Uuid

  cantidad         Int      @default(1)
  nombrePropiedad  String
  marcaModelo      String?
  serie            String?
  fechaAdquisicion DateTime?
  costoAdquisicion Decimal? @db.Decimal(12, 2)
  cuentaContable   String?
  vidaUtil         Decimal? @db.Decimal(5, 2) // Pre-calculado en base a Ley Hondureña desde el CSV

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  activosFijos     ActivoFijo[]

  @@index([organizationId])
  @@index([serie])
  @@map("inventario_historico")
}

