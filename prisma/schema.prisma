model CajaChicaSession {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                 @db.Uuid
  estado           String                 @default("ABIERTA") // ABIERTA, CERRADA
  saldoInicial     Float
  saldoFinal       Float?                 // Saldo calculado
  saldoReal        Float?                 // Saldo contado fisicamente en el arqueo
  diferencia       Float?                 // Faltante o Sobrante
  observaciones    String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  cerradaAt        DateTime?
  
  // Trazabilidad
  creadoPorId      String?                @db.Uuid
  cerradoPorId     String?                @db.Uuid
  
  creadoPor        User?                  @relation("CreatedCajaSession", fields: [creadoPorId], references: [id])
  cerradoPor       User?                  @relation("ClosedCajaSession", fields: [cerradoPorId], references: [id])
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movimientos      CajaChicaMovimiento[]

  @@map("caja_chica_sessions")
}

model CajaChicaMovimiento {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String            @db.Uuid
  tipo             String            // INGRESO, SALIDA
  categoria        String
  descripcion      String
  documento        String            // RECIBO, FACTURA, SIN DOCUMENTO
  nroDoc           String?
  adjuntoUrl       String?           // Para documentos de respaldo en R2
  importe          Float
  moneda           String            @default("HNL")
  tipoCambio       Float             @default(1)
  total            Float             // importe * tipoCambio
  beneficiario     String?
  estado           String            @default("REGISTRADO") // REGISTRADO, ANULADO
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  // Trazabilidad
  creadoPorId      String?           @db.Uuid
  anuladaPorId     String?           @db.Uuid
  anuladaAt        DateTime?
  
  creadoPor        User?             @relation("CreatedCajaMov", fields: [creadoPorId], references: [id])
  anuladaPor       User?             @relation("AnuladaCajaMov", fields: [anuladaPorId], references: [id])
  session          CajaChicaSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("caja_chica_movimientos")
}

// Nuevo modelo de Cierre/Corte de Caja Diario
model CorteCajaSession {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String            @db.Uuid
  estado             String            @default("ABIERTA") // ABIERTA, CERRADA
  saldoInicial       Decimal           @db.Decimal(12, 2)
  saldoFinalEfectivo Decimal?          @db.Decimal(12, 2) // Monto físico real contado en el arqueo
  diferencia         Decimal?          @db.Decimal(12, 2) // Saldo Real - Saldo Esperado en efectivo
  observaciones      String?
  aperturaAt         DateTime          @default(now())
  cierreAt           DateTime?
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Trazabilidad Estándar
  creadoPorId        String?           @db.Uuid
  modificadoPorId    String?           @db.Uuid
  cerradoPorId       String?           @db.Uuid
  
  creadoPor          User?             @relation("CreatedCortes", fields: [creadoPorId], references: [id])
  modificadoPor      User?             @relation("UpdatedCortes", fields: [modificadoPorId], references: [id])
  cerradoPor         User?             @relation("ClosedCortes", fields: [cerradoPorId], references: [id])
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // Relaciones transaccionales del turno
  facturas           Factura[]
  rentasPagos        RentaPago[]
  ordenesTrabajo     OrdenTrabajo[]
  movimientos        CorteCajaMovimiento[]
  
  @@map("cortes_caja_sessions")
}

model CorteCajaMovimiento {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String            @db.Uuid
  sessionId        String            @db.Uuid
  tipo             String            // INGRESO, EGRESO
  concepto         String            // RETIRO_BANCARIO, REEMBOLSO_GARANTIA, OTRO
  descripcion      String
  monto            Decimal           @db.Decimal(12, 2)
  metodoPago       String            @default("Efectivo")
  referenciaId     String?           // ID de la transacción/renta original (si aplica)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Trazabilidad Estándar
  creadoPorId      String?           @db.Uuid
  anuladaPorId     String?           @db.Uuid
  anuladaAt        DateTime?

  creadoPor        User?             @relation("CreatedCorteMovs", fields: [creadoPorId], references: [id])
  anuladaPor       User?             @relation("AnuladaCorteMovs", fields: [anuladaPorId], references: [id])
  session          CorteCajaSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([sessionId])
  @@map("cortes_caja_movimientos")
}

model KanbanSpace {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String               @db.Uuid
  nombre          String
  clave           String               // Ej: "DB" para Desarrollo Bioelectrónica
  tiposActividad  String[]             @default(["Task", "Story", "Feature", "Bug"])
  columnas        String[]             @default(["Por hacer", "En curso", "En revisión", "Listo"])
  lastTaskNumber  Int                  @default(0) // Para generar DB-1, DB-2 correlativos
  archivado       Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  acceso          String               @default("Abierto") // "Abierto" o "Restringido"
  miembros        User[]               @relation("KanbanSpaceMembers")

  creadoPorId     String?              @db.Uuid
  creadoPor       User?                @relation("CreatedKanbanSpaces", fields: [creadoPorId], references: [id])
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks           KanbanTask[]
  activities      KanbanActivity[]

  @@unique([organizationId, clave])
  @@map("kanban_spaces")
}

model KanbanTask {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId         String               @db.Uuid
  organizationId  String               @db.Uuid
  codigo          String               // Ej: "DB-4"
  title           String
  description     String?
  status          String               // Ej: "Por hacer", "En curso"
  type            String               // Ej: "Task", "Bug"
  priority        String               @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate         DateTime?
  startDate       DateTime?
  etiquetas       String[]             @default([])
  team            String?
  modulo          String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  asignadoId      String?              @db.Uuid
  creadoPorId     String?              @db.Uuid
  modificadoPorId String?              @db.Uuid
  parentId        String?              @db.Uuid

  ordenTrabajoId  String?              @db.Uuid
  ordenTrabajo    OrdenTrabajo?        @relation(fields: [ordenTrabajoId], references: [id], onDelete: SetNull)

  space           KanbanSpace          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asignado        User?                @relation("AssignedKanbanTasks", fields: [asignadoId], references: [id])
  creadoPor       User?                @relation("CreatedKanbanTasks", fields: [creadoPorId], references: [id])
  modificadoPor   User?                @relation("ModifiedKanbanTasks", fields: [modificadoPorId], references: [id])
  asignados       User[]               @relation("KanbanTaskAssignees")
  parent          KanbanTask?          @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks        KanbanTask[]         @relation("TaskHierarchy")
  activities      KanbanActivity[]
  comments        KanbanComment[]
  attachments     KanbanAttachment[]

  @@unique([spaceId, codigo])
  @@index([spaceId])
  @@map("kanban_tasks")
}

model KanbanActivity {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spaceId         String               @db.Uuid
  taskId          String?              @db.Uuid
  usuarioId       String               @db.Uuid
  accion          String               // Ej: "CREACION", "MOVIMIENTO", "PRIORIDAD", "COMENTARIO"
  detalles        String               // Ej: "De 'Por hacer' a 'En curso'"
  createdAt       DateTime             @default(now())

  space           KanbanSpace          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  task            KanbanTask?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  usuario         User                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([taskId])
  @@map("kanban_activities")
}

model KanbanComment {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
