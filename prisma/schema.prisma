generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  slug                  String                 @unique
  domain                String?                @unique
  logoUrl               String?
  direccion             String?
  telefono              String?
  correoContacto        String?
  rtn                   String?
  status                OrganizationStatus     @default(ACTIVE)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  activosFijos          ActivoFijo[]
  areaInventoryStatuses AreaInventoryStatus[]
  areas                 Area[]
  calendarIntegrations  CalendarIntegration[]
  checkIns              CheckIn[]
  classrooms            Classroom[]
  colaImpresion         ColaImpresion[]
  colaImpresionCheckins ColaImpresionCheckin[]
  conciliations         Conciliation[]
  emailTemplates        EmailTemplate[]
  events                Event[]
  kids                  Kid[]
  medicalPatients       MedicalPatient[]
  passwordVaults        PasswordVault[]
  roleTemplates         RoleTemplate[]
  tasks                 Task[]
  users                 User[]
  productos             Producto[]
  clientes              Cliente[]
  facturas              Factura[]

  @@map("organizations")
}

model User {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                @unique
  organizationId       String                @db.Uuid
  role                 Role                  @default(USER)
  phoneNumber          String?
  twoFactorType        TwoFactorType         @default(NONE)
  twoFactorSecret      String?
  twoFactorEnabled     Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  accessibleModules    String[]              @default([])
  customRoleName       String?
  defaultModule        String?
  timezone             String?               @default("America/Tegucigalpa")
  theme                String?               @default("system")
  approvedAreas        AreaInventoryStatus[] @relation("AreaApprovedBy")
  closedAreas          AreaInventoryStatus[] @relation("AreaClosedBy")
  openedAreas          AreaInventoryStatus[] @relation("AreaOpenedBy")
  calendarIntegrations CalendarIntegration[]
  medicalRecords       MedicalRecord[]
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("users")
}

model RoleTemplate {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @db.Uuid
  name              String
  baseRole          Role         @default(USER)
  accessibleModules String[]     @default([])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("role_templates")
}

model EmailTemplate {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @db.Uuid
  type           EmailTemplateType
  subject        String
  title          String
  body           String
  buttonText     String
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type])
  @@map("email_templates")
}

model PasswordVault {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  title          String
  username       String
  encryptedPass  String
  url            String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  category       String       @default("General")
  details        Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("password_vaults")
}

model Event {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("events")
}

model Conciliation {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  month          Int
  year           Int
  status         String       @default("PROCESSING")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  approvedAt     DateTime?
  approvedBy     String?
  banco          String
  filesFound     String[]
  isApproved     Boolean      @default(false)
  reportContent  Json?
  reportSummary  String?
  tipoCuenta     String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("conciliations")
}

model Classroom {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  ageRange       String?
  teacher        String?
  capacity       Int          @default(20)
  color          String?      @default("bg-brand-100 text-brand-700 border-brand-200")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kids           Kid[]

  @@map("classrooms")
}

model Kid {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  age            Int
  classroomName  String?
  allergies      String       @default("Ninguna")
  parentName     String
  parentPhone    String
  parent2Name    String?
  parent2Phone   String?
  visitingChurch String?
  photoEmoji     String       @default("🧒")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  classroomId    String?      @db.Uuid
  gender         String       @default("No Especificado")
  checkIns       CheckIn[]
  classroom      Classroom?   @relation(fields: [classroomId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("kids")
}

model CheckIn {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  kidId          String       @db.Uuid
  securityCode   String
  checkInTime    DateTime     @default(now())
  checkOutTime   DateTime?
  checkedOut     Boolean      @default(false)
  parentNotified Boolean      @default(false)
  notifProvider  String?
  notifMessageId String?
  createdAt      DateTime     @default(now())
  kid            Kid          @relation(fields: [kidId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("check_ins")
}

model MedicalPatient {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String          @db.Uuid
  firstName             String
  lastName              String
  dateOfBirth           DateTime
  gender                String
  phone                 String?
  email                 String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  bloodType             String?
  allergies             String?
  chronicConditions     String?
  currentMedications    String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  organization          Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  records               MedicalRecord[]

  @@index([organizationId])
  @@index([firstName, lastName])
  @@index([phone])
  @@map("medical_patients")
}

model MedicalRecord {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId      String         @db.Uuid
  attendedById   String         @db.Uuid
  visitDate      DateTime       @default(now())
  reasonForVisit String
  vitals         Json?
  diagnosis      String?
  treatment      String?
  notes          String?
  status         String         @default("COMPLETED")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  attendedBy     User           @relation(fields: [attendedById], references: [id], onDelete: SetNull)
  patient        MedicalPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([visitDate])
  @@map("medical_records")
}

model CalendarIntegration {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @db.Uuid
  userId             String       @db.Uuid
  googleAccessToken  String
  googleRefreshToken String
  googleEmail        String
  syncToken          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("calendar_integrations")
}

model Task {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  title          String
  description    String?
  status         String       @default("TODO")
  priority       String       @default("MEDIUM")
  dueDate        DateTime?
  googleEventId  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("tasks")
}

model ActivoFijo {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String               @db.Uuid
  idQr                  String
  descripcionCorta      String
  descripcionDetallada  String?
  serie                 String?
  modelo                String?
  area                  String
  cuentaAct             String
  estatusContable       String               @default("VIGENTE")
  fechaAdq              DateTime?
  integrado             Boolean              @default(false)
  costoAdq              Decimal?             @db.Decimal(12, 2)
  origenActivo          String?
  imagenUrl             String?
  estadoDano            String?
  tipoIncidencia        String?
  accionRecomendada     String?
  responsable           String?
  observaciones         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  imagenPlacaUrl        String?
  fechaLevantamiento    DateTime?
  categoriaDepreciacion String?
  historicoId           String?              @db.Uuid
  codigoBarras          String?
  stock                 Int                  @default(1)
  vidaUtilOverride      Decimal?             @db.Decimal(5, 2)
  codigoGrupo           String?
  valResidual           Decimal?             @db.Decimal(12, 2)
  baseDeprec            Decimal?             @db.Decimal(12, 2)
  deprecMensual         Decimal?             @db.Decimal(12, 4)
  deprecAcum            Decimal?             @db.Decimal(12, 2)
  valorLibros           Decimal?             @db.Decimal(12, 2)
  marca                 String?
  inventarioHistorico   InventarioHistorico? @relation(fields: [historicoId], references: [id])
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  colaImpresion         ColaImpresion[]
  detallesFactura       DetalleFactura[]

  @@unique([organizationId, idQr])
  @@index([organizationId])
  @@index([organizationId, estatusContable])
  @@index([organizationId, estadoDano])
  @@index([organizationId, area])
  @@map("activos_fijos")
}

model AreaInventoryStatus {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  areaCode       String
  qrCode         String
  status         String       @default("PENDING")
  openedById     String?      @db.Uuid
  closedById     String?      @db.Uuid
  approvedById   String?      @db.Uuid
  openedAt       DateTime?
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  approvedBy     User?        @relation("AreaApprovedBy", fields: [approvedById], references: [id])
  closedBy       User?        @relation("AreaClosedBy", fields: [closedById], references: [id])
  openedBy       User?        @relation("AreaOpenedBy", fields: [openedById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, areaCode])
  @@unique([organizationId, qrCode])
  @@index([organizationId])
  @@map("area_inventory_status")
}

model ColaImpresion {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  activoId       String       @db.Uuid
  urlImagen      String
  estado         String       @default("PENDIENTE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activo         ActivoFijo   @relation(fields: [activoId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([estado])
  @@map("cola_impresion")
}

model Area {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  prefix         String
  qrCode         String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@unique([organizationId, qrCode])
  @@index([organizationId])
  @@map("areas")
}

model InventarioHistorico {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String       @db.Uuid
  cantidad             Int          @default(1)
  nombrePropiedad      String
  serie                String?
  fechaAdquisicion     DateTime?
  costoAdquisicion     Decimal?     @db.Decimal(12, 2)
  cuentaContable       String?
  vidaUtil             Decimal?     @db.Decimal(5, 2)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  descripcionCorta     String?
  marca                String?
  modelo               String?
  observaciones        String?
  descripcionDetallada String?
  imagenPlacaUrl       String?
  imagenUrl            String?
  nombreOriginal       String?
  serieOriginal        String?
  clasificacion        String?      @default("ACTIVO") // ACTIVO o EQUIPO_MENOR
  activosFijos         ActivoFijo[]

  @@index([organizationId])
  @@index([serie])
  @@index([organizationId, clasificacion])
  @@map("inventario_historico")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  USER
  CHECKIN_KIDS
  MEDICAL_STAFF
  EXECUTIVE_ASSISTANT
  CHECKIN_KIDS_ADMIN
  INVENTARIO_EDITOR
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum TwoFactorType {
  NONE
  WHATSAPP
  TOTP
}

enum EmailTemplateType {
  CLASSIC_WELCOME
  GOOGLE_WELCOME
}

model ColaImpresionCheckin {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  datosEtiqueta  Json
  estado         String       @default("PENDIENTE")
  impresora      String       @default("TSC TE200")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([estado])
  @@map("cola_impresion_checkin")
}

model Producto {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  sku            String   @unique // Codigo de barra genérico o SKU numérico
  nombre         String
  descripcion    String?
  marca          String?
  modelo         String?
  precioVenta    Decimal  @db.Decimal(12, 2)
  costoBase      Decimal? @db.Decimal(12, 2)
  stockActual    Int      @default(0)
  stockMinimo    Int      @default(5)
  isvAplicable   Int      @default(15) // 0, 15, 18
  estado         String   @default("ACTIVO") // ACTIVO, INACTIVO
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  detallesFactura DetalleFactura[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@map("productos")
}

model Cliente {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  nombre         String
  rtn            String? // R.T.N. hondureño
  telefono       String?
  email          String?
  direccion      String?
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  facturas     Factura[]

  @@index([organizationId])
  @@index([nombre])
  @@map("clientes")
}

model Factura {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  numeroCAI      String? // Clave de Autorización de Impresión
  correlativo    String // Ej. 000-001-01-003557
  numeroInterno  Int      @default(autoincrement()) // Para ordenar fácilmente
  fechaEmision   DateTime @default(now())

  clienteId String  @db.Uuid
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  // Totales de Factura
  subTotal       Decimal @default(0) @db.Decimal(12, 2)
  descuentos     Decimal @default(0) @db.Decimal(12, 2)
  totalExento    Decimal @default(0) @db.Decimal(12, 2)
  totalExonerado Decimal @default(0) @db.Decimal(12, 2)
  totalGravado15 Decimal @default(0) @db.Decimal(12, 2)
  isv15          Decimal @default(0) @db.Decimal(12, 2)
  totalGravado18 Decimal @default(0) @db.Decimal(12, 2)
  isv18          Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)

  estado String @default("BORRADOR") // BORRADOR, EMITIDA, ANULADA, PAGADA

  // Datos SAR 
  rangoAutorizado          String?
  fechaLimiteEmision       DateTime?
  ordenCompraExenta        String?
  constanciaRegistroExenta String?
  registroSag              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  detalles     DetalleFactura[]

  @@unique([organizationId, correlativo])
  @@index([organizationId])
  @@index([estado])
  @@map("facturas")
}

model DetalleFactura {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  facturaId String  @db.Uuid
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  // El Puente Opcional
  productoId String?   @db.Uuid
  producto   Producto? @relation(fields: [productoId], references: [id])

  activoId String?     @db.Uuid
  activo   ActivoFijo? @relation(fields: [activoId], references: [id])

  descripcion    String // Texto de "Mano de Obra" o nombre calcado del producto
  cantidad       Int
  precioUnitario Decimal @db.Decimal(12, 2)
  porcentajeIsv  Int     @default(15) // 0, 15, 18
  totalDescuento Decimal @default(0) @db.Decimal(12, 2)
  totalLinea     Decimal @db.Decimal(12, 2)

  @@index([facturaId])
  @@map("detalles_factura")
}
